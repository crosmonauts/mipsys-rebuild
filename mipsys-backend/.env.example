# === BACKEND .ENV ===
# Untuk development lokal, copy file ini ke .env dan sesuaikan.
# Untuk Railway: cukup set DATABASE_URL, CORS_ORIGINS, JWT_SECRET, JWT_EXPIRES_IN
# Railway PostgreSQL plugin akan auto-inject DATABASE_URL

# Database (PostgreSQL via Docker)
DB_HOST=127.0.0.1
DB_USER=mipsys
DB_PASS=mipsys
DB_NAME=db_mipsys
DB_PORT=5433
DB_CONNECTION_LIMIT=10
DATABASE_URL=postgresql://mipsys:mipsys@127.0.0.1:5433/db_mipsys

# CORS — domain frontend yang diizinkan akses API
CORS_ORIGINS=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development

# JWT — WAJIB min 32 karakter, generate via: openssl rand -base64 36
# Contoh isi .env lokal: JWT_SECRET=<48-karakter-acak-anda>
# Jangan commit secret asli ke git. File ini hanya template.
JWT_SECRET=REPLACE_ME_MIN_32_CHARS_GENERATE_WITH_OPENSSL_RAND_BASE64_36
JWT_EXPIRES_IN=1d
